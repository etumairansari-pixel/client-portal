# ===========================================================================
# Eiretech Client Management & Client Portal
# Copy to `.env` and fill in. PLACEHOLDERS ONLY - never commit real secrets.
# ===========================================================================

# MongoDB connection string, including the database name.
# Local/dev and production both use this single variable.
DATABASE_URL="<MONGODB_CONNECTION_STRING>"

# Random secret. Generate with:
#   node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
SESSION_SECRET="<RANDOM_SECRET>"

# Public base URL of the app.
# Local:      http://localhost:3000
# Production: https://portal.eiretech360.com
APP_URL="http://localhost:3000"

# ---------------------------------------------------------------------------
# Email (password reset). Leave blank in development: messages are logged to
# the server console instead of being sent. Token generation, expiry and
# single-use rules work either way.
# ---------------------------------------------------------------------------
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
SMTP_FROM="Eiretech <no-reply@eiretech360.com>"
