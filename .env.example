# ===========================================================================
# Eiretech Client Portal — environment
# Copy to `.env` and fill in. PLACEHOLDERS ONLY - never commit real secrets.
# Every variable is validated at startup (server/utils/env.ts); the server
# refuses to boot with a missing or malformed value and names the variable.
# ===========================================================================

# development | production. The built server assumes production when unset.
NODE_ENV=development

# MongoDB Atlas connection string, including the database name.
DATABASE_URL="<MONGODB_CONNECTION_STRING>"

# Random secret, at least 32 characters in production. Generate with:
#   node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
SESSION_SECRET="<RANDOM_SECRET>"

# Public base URL. Used for links in emails and redirects.
# Local:      http://localhost:3000
# Production: https://portal.eiretech360.com
APP_URL="http://localhost:3000"

# Hostinger / any Node host: the runtime listens on HOST:PORT (Nitro reads
# both, plus NITRO_HOST / NITRO_PORT). Leave unset locally.
# PORT=3000
# HOST=0.0.0.0

# ---------------------------------------------------------------------------
# Email. Setting SMTP_HOST switches on real delivery through Nodemailer.
# Without it, messages are only logged (subject + recipient, never the body).
# SMTP_SECURE=true for implicit TLS (port 465); leave false for STARTTLS (587).
# ---------------------------------------------------------------------------
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASS=
SMTP_FROM="Eiretech <no-reply@eiretech360.com>"

# Development/test ONLY: also append every outgoing message as JSON to this
# file so links can be inspected. Refused in production.
# MAIL_OUTBOX_FILE=.data/outbox.jsonl

# ---------------------------------------------------------------------------
# Files. `local` writes to STORAGE_ROOT on the application server (fine for
# development). Production should use `s3` with any S3-compatible bucket
# (AWS S3, Cloudflare R2, Backblaze B2, DigitalOcean Spaces, MinIO, …).
# The bucket must be PRIVATE; the app never exposes object URLs.
# ---------------------------------------------------------------------------
STORAGE_DRIVER=local
STORAGE_ROOT=.data/uploads
# S3_BUCKET=
# S3_REGION=            # e.g. eu-west-1 (AWS) or auto (R2)
# S3_ENDPOINT=          # required for non-AWS providers, e.g. https://<account>.r2.cloudflarestorage.com
# S3_ACCESS_KEY=
# S3_SECRET_KEY=
# S3_FORCE_PATH_STYLE=false
